# SQLAlchemy connection URL; SQLite is suitable for local development.
DATABASE_URL=sqlite:///./zoom.db
# Browser frontend origin allowed to call the API.
FRONTEND_URL=https://frontend.example.com
# Optional extra origins as a JSON array; Vercel preview URLs are allowed separately.
CORS_ORIGINS=[]
# Generate a unique secret for each deployed environment; this sample is not a credential.
JWT_SECRET=replace-this-with-a-random-secret-before-deployment
# Signing algorithm used for bearer tokens.
JWT_ALGORITHM=HS256
# Token lifetime in hours.
JWT_EXPIRY_HOURS=24
