# Public URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=https://api.example.com
# Public WebSocket endpoint used for meeting signaling.
NEXT_PUBLIC_WS_URL=wss://api.example.com
# Public STUN server used to establish peer-to-peer media connections.
NEXT_PUBLIC_STUN_SERVER_URL=stun:stun.l.google.com:19302
